{
    "name": "channor/hashed-route-key",
    "description": "Deterministic hashed route keys for integer IDs with keyed integrity checks.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "route-key",
        "hashed-route-key",
        "obfuscation",
        "hashids"
    ],
    "homepage": "https://github.com/channor/hashed-route-key",
    "support": {
        "issues": "https://github.com/channor/hashed-route-key/issues",
        "source": "https://github.com/channor/hashed-route-key/tree/main"
    },
    "authors": [
        {
            "name": "Channor",
            "homepage": "https://github.com/channor"
        }
    ],
    "autoload": {
        "psr-4": {
            "Channor\\HashedRouteKey\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Channor\\HashedRouteKey\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^9.0|^10.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist",
        "format": "pint",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
