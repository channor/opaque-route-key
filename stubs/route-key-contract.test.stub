        $modelClass = self::MODEL_CLASS;
        $model = new $modelClass;

        $minPayloadLength = (fn () => $this->routeKeyMinPayloadLength())->call($model);
        $checkLength = (fn () => $this->routeKeyCheckLength())->call($model);
        $offsetMultiplier = (fn () => $this->routeKeyOffsetMultiplier())->call($model);
        $saltSuffix = (fn () => $this->routeKeySaltSuffix())->call($model);

        $this->assertSame({{ minPayloadLength }}, $minPayloadLength, self::CHANGE_MESSAGE);
        $this->assertSame({{ checkLength }}, $checkLength, self::CHANGE_MESSAGE);
        $this->assertSame({{ offsetMultiplier }}, $offsetMultiplier, self::CHANGE_MESSAGE);
        $this->assertSame({{ saltSuffix }}, $saltSuffix, self::CHANGE_MESSAGE);
    }

