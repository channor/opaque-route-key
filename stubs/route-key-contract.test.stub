    }

    protected function setUp(): void
    {
        parent::setUp();

        $this->originalRouteKeySalt = config(self::ROUTE_KEY_CONFIG.'.salt');
        $this->originalReservedWords = config(self::ROUTE_KEY_CONFIG.'.reserved_words');
        $this->originalReservedWordsCaseSensitive = config(self::ROUTE_KEY_CONFIG.'.reserved_words_case_sensitive');
        $this->originalReservedWordAutoReserveModelNames = config(self::ROUTE_KEY_CONFIG.'.auto_reserve_model_names');
        $this->originalReservedWordMaxAttempts = config(self::ROUTE_KEY_CONFIG.'.reserved_word_max_attempts');

        config([
            self::ROUTE_KEY_CONFIG.'.salt' => self::FIXED_SALT_BASE,
            self::ROUTE_KEY_CONFIG.'.reserved_words' => [],
            self::ROUTE_KEY_CONFIG.'.reserved_words_case_sensitive' => true,
            self::ROUTE_KEY_CONFIG.'.auto_reserve_model_names' => false,
            self::ROUTE_KEY_CONFIG.'.reserved_word_max_attempts' => 10,
        ]);
    }

    protected function tearDown(): void
    {
        config([
            self::ROUTE_KEY_CONFIG.'.salt' => $this->originalRouteKeySalt,
            self::ROUTE_KEY_CONFIG.'.reserved_words' => $this->originalReservedWords,
            self::ROUTE_KEY_CONFIG.'.reserved_words_case_sensitive' => $this->originalReservedWordsCaseSensitive,
            self::ROUTE_KEY_CONFIG.'.auto_reserve_model_names' => $this->originalReservedWordAutoReserveModelNames,
            self::ROUTE_KEY_CONFIG.'.reserved_word_max_attempts' => $this->originalReservedWordMaxAttempts,
        ]);

        parent::tearDown();
    }
